<Window x:Class="GhubLite.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="GhubLite"
        Width="520" Height="820"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        FontFamily="{StaticResource BodyFont}"
        Foreground="{StaticResource TextPrimary}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded">

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProfileCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>

    <Grid Margin="20">
        <Border x:Name="RootCard" CornerRadius="24" Background="{StaticResource WindowBackground}"
                BorderBrush="#1B2331" BorderThickness="1"
                Effect="{StaticResource WindowShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="34" />
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Grid Grid.Row="0" Margin="18,0,12,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="Assets/app.png" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Grid.Column="1" Text="GHUBLITE" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <TextBlock Grid.Column="2" Text="0.1" FontSize="10" Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center" Margin="8,1,0,0" />
                    <Button Grid.Column="3" Content="&#xE921;" Style="{StaticResource IconButton}"
                            Click="Minimize_Click" ToolTip="最小化" />
                    <Button Grid.Column="4" Content="&#xE8BB;" Style="{StaticResource CloseButton}"
                            Click="Close_Click" ToolTip="关闭到托盘" />
                </Grid>

                <!-- Device header -->
                <Grid Grid.Row="1" Margin="26,2,26,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding DeviceName}" FontFamily="{StaticResource DisplayFont}"
                                   FontSize="27" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Ellipse Width="7" Height="7" Fill="{Binding ConnectionBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ConnectionText}" FontSize="11" Foreground="{StaticResource TextSecondary}"
                                       Margin="7,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="  ·  " FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ProtocolText}" FontSize="11" Foreground="{StaticResource TextMuted}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <Border Background="#121A26" BorderBrush="#202A3A" BorderThickness="1" CornerRadius="13" Padding="11,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE83F;" FontSize="13"
                                           Foreground="{Binding BatteryBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding BatteryText}" FontSize="13" FontWeight="SemiBold"
                                           Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding ActiveProfileLabel}" FontSize="10" Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Right" Margin="0,6,2,0" />
                    </StackPanel>
                </Grid>

                <!-- Tabs + content -->
                <TabControl x:Name="MainTabs" Grid.Row="2" Style="{StaticResource PillTabControl}" SelectedIndex="0"
                            SelectionChanged="MainTabs_SelectionChanged">
                    <!-- MOUSE -->
                    <TabItem Header="鼠标" Style="{StaticResource PillTabItem}">
                        <ScrollViewer x:Name="MouseScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="MouseStack" Margin="26,0,20,18">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="配置文件" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding ActiveProfileLabel}" Style="{StaticResource SectionLabel}"
                                               Foreground="{StaticResource Accent}" HorizontalAlignment="Right" />
                                </Grid>
                                <ListBox x:Name="ProfileList" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}"
                                         Style="{StaticResource ChipListBox}" Margin="0,0,0,10">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource ChipItem}">
                                            <Setter Property="Padding" Value="8,7" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel MinWidth="64">
                                                <TextBlock Text="{Binding ShortName}" FontSize="10" FontWeight="Bold"
                                                           Foreground="{StaticResource TextMuted}" />
                                                <TextBlock Text="{Binding NameDisplay}" FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="72" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border Margin="0,0,0,16" Background="{StaticResource BgInput}" BorderBrush="{StaticResource Stroke}"
                                        BorderThickness="1" CornerRadius="9" Padding="10,0" Height="38">
                                    <TextBox x:Name="ProfileNameBox" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.AutomationId="ProfileNameBox"
                                             Style="{StaticResource DarkTextBox}" MaxLength="24"
                                             ToolTip="配置名称，最多 24 个字符" />
                                </Border>

                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="修改后自动应用并写入板载" Style="{StaticResource Muted}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding EditStateText}" FontSize="10"
                                               Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <!-- DPI -->
                                <Border x:Name="DpiCard" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="DPI" Style="{StaticResource SectionLabel}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding Dpi}" FontSize="42" FontWeight="Bold"
                                                               FontFamily="{StaticResource DisplayFont}" />
                                                    <TextBlock Text="dpi" FontSize="12" Foreground="{StaticResource TextMuted}"
                                                               Margin="6,18,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Background="#101B26" BorderBrush="#1E3040" BorderThickness="1"
                                                    CornerRadius="9" Padding="9,5">
                                                <TextBlock Text="{Binding SelectedDpiSlotNumber, StringFormat='默认槽 {0}'}"
                                                           FontSize="10" Foreground="{StaticResource Accent}" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                        <Slider x:Name="DpiSlider" AutomationProperties.AutomationId="DpiSlider"
                                                AutomationProperties.Name="DPI 滑块"
                                                Style="{StaticResource AccentSlider}" Margin="0,12,0,2"
                                                Minimum="100" Maximum="25600" TickFrequency="50"
                                                IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                                                Value="{Binding Dpi, Mode=TwoWay}" />
                                        <ItemsControl ItemsSource="{Binding DpiSlots}" Margin="0,6,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Value}" Style="{StaticResource ChipButton}"
                                                            Margin="0,0,7,0"
                                                            AutomationProperties.Name="{Binding Display}"
                                                            Command="{Binding DataContext.SelectDpiSlotCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="拖动滑块调整当前槽位；点击下方槽位切换默认 DPI。" Style="{StaticResource Muted}"
                                                   Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Report rate -->
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="回报率" Style="{StaticResource SectionLabel}" />
                                            <TextBlock Text="{Binding SelectedReportRate.Summary}" FontSize="11"
                                                       Foreground="{StaticResource Accent}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding ReportRateOptions}" Margin="0,10,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource ChipButton}" Margin="0,0,7,0"
                                                            AutomationProperties.Name="{Binding Summary}"
                                                            Command="{Binding DataContext.SelectReportRateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}">
                                                        <StackPanel HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding HzText}" FontSize="18" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                                                            <TextBlock Text="Hz" FontSize="9" Foreground="{StaticResource TextMuted}"
                                                                       HorizontalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="1000 Hz 延迟最低，125 Hz 更省电。" Style="{StaticResource Muted}"
                                                   Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Battery -->
                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="电量" Style="{StaticResource SectionLabel}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding BatteryText}" FontSize="32" FontWeight="Bold"
                                                           FontFamily="{StaticResource DisplayFont}" />
                                                <TextBlock Text="{Binding BatteryStatusText}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondary}" Margin="9,15,0,0" />
                                            </StackPanel>
                                            <ProgressBar Value="{Binding BatteryProgress, Mode=OneWay}" Maximum="100"
                                                         Style="{StaticResource BatteryBar}" Margin="0,10,0,8" />
                                            <TextBlock Text="{Binding BatteryLevelText}" Style="{StaticResource Muted}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                                            <TextBlock Text="{Binding BatteryUpdatedText}" FontSize="10"
                                                       Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- APPS -->
                    <TabItem Header="应用" Style="{StaticResource PillTabItem}">
                        <ScrollViewer x:Name="AppsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="26,0,20,18">
                                <Border Style="{StaticResource Card}">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="按应用自动切换" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="前台应用匹配规则时，自动切换对应板载配置，并立即应用该配置的 DPI 与回报率。"
                                                       Style="{StaticResource Muted}" Margin="0,5,36,0" MaxWidth="300" />
                                        </StackPanel>
                                        <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoSwitch}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Border Background="#1A2230" BorderBrush="#2A3648" BorderThickness="1" CornerRadius="14"
                                        Padding="14" Margin="0,0,0,14"
                                        Visibility="{Binding ShowEnableProfiles, Converter={StaticResource BoolToVis}}">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="P2–P5 尚未启用" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding EnableProfilesHint}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Button Content="启用 5 个配置" Command="{Binding EnableProfilesCommand}"
                                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="应用规则" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding RulesCountText}" Style="{StaticResource SectionLabel}"
                                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <Button Content="+ 当前应用" Command="{Binding AddCurrentAppCommand}"
                                                        Style="{StaticResource GhostButton}" />
                                            </StackPanel>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Rules}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#0F141E" BorderBrush="#1E2635" BorderThickness="1"
                                                            CornerRadius="12" Padding="10" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid Width="34" Height="34">
                                                                <Border Background="{Binding AccentBrush}" Opacity="0.16" CornerRadius="9" />
                                                                <TextBlock Text="{Binding Initial}" FontSize="14" FontWeight="Bold"
                                                                           Foreground="{Binding AccentBrush}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Grid>
                                                            <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding ProcessName}" FontSize="10"
                                                                           Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <Border Grid.Column="2" Background="#16202C" CornerRadius="8"
                                                                    Padding="8,4" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ProfileLabel}" FontSize="10" FontWeight="Bold"
                                                                           Foreground="{Binding AccentBrush}" />
                                                            </Border>
                                                            <Button Grid.Column="3" Content="&#xE711;"
                                                                    Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}" Style="{StaticResource IconButton}"
                                                                    Width="28" Height="28" Margin="2,0,0,0" ToolTip="移除规则" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Visibility="{Binding HasNoRules, Converter={StaticResource BoolToVis}}"
                                                    Margin="0,10,0,2">
                                            <TextBlock Text="还没有规则" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="打开一个应用，然后点右上角 “+ 当前应用”。" Style="{StaticResource Muted}"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="板载配置" Style="{StaticResource SectionLabel}" Margin="2,0,0,8" />
                                <ItemsControl ItemsSource="{Binding Profiles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ProfileCard}">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock Text="{Binding ShortName}" FontSize="10" FontWeight="Bold"
                                                                   Foreground="{StaticResource TextMuted}" />
                                                        <Ellipse Width="8" Height="8" Fill="{Binding AccentBrush}"
                                                                 HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding NameDisplay}" FontSize="14" FontWeight="SemiBold"
                                                               Margin="0,6,0,2" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Summary}" FontSize="10"
                                                               Foreground="{StaticResource TextSecondary}" />
                                                    <TextBlock Text="{Binding AssignedText}" FontSize="10"
                                                               Foreground="{StaticResource TextMuted}" Margin="0,2,0,4" />
                                                    <Button Content="+ 当前应用"
                                                            Command="{Binding DataContext.AssignCurrentAppCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" Style="{StaticResource GhostButton}"
                                                            HorizontalAlignment="Left" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Background="#101722" BorderBrush="#1E2A3A" BorderThickness="1" CornerRadius="14"
                                        Padding="14">
                                    <TextBlock Text="GhubLite 只切换鼠标的板载配置，不注入按键、不挂驱动。切到未匹配的应用时，会回到默认配置 P1。"
                                               Style="{StaticResource Muted}" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- SETTINGS -->
                    <TabItem Header="设置" Style="{StaticResource PillTabItem}">
                        <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="26,0,20,18">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="应用" Style="{StaticResource SectionLabel}" Margin="0,0,0,10" />
                                        <Grid Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="开机启动" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="登录 Windows 后自动运行 GhubLite。" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="关闭时最小化到托盘" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="保留按应用自动切换。" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding MinimizeToTray}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="数据" Style="{StaticResource SectionLabel}" Margin="0,0,0,10" />
                                        <Grid>
                                            <Button Content="备份到文件" Command="{Binding BackupCommand}"
                                                    Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" />
                                            <Button Content="从备份恢复" Command="{Binding RestoreCommand}"
                                                    Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <TextBlock Text="{Binding BackupStatus}" Style="{StaticResource Muted}" Margin="0,10,0,0" />
                                        <TextBlock Text="写入板载配置前会自动备份到 %APPDATA%\GhubLite\backups。"
                                                   Style="{StaticResource Muted}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="设备" Style="{StaticResource SectionLabel}" />
                                            <Button Content="刷新" Command="{Binding RefreshCommand}" Style="{StaticResource GhostButton}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="{Binding DeviceDetails}" FontSize="10" Foreground="{StaticResource TextSecondary}"
                                                   TextWrapping="Wrap" LineHeight="17" Margin="0,8,0,0" />
                                        <Button Content="重新连接" Command="{Binding ReconnectCommand}"
                                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#101722" BorderBrush="#1E2A3A" BorderThickness="1" CornerRadius="14" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="GhubLite 0.1" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="直接通过 HID++ 2.0 控制 PRO X SUPERLIGHT。本地运行，无遥测，无驱动，无后台服务。"
                                                   Style="{StaticResource Muted}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

                <!-- Footer -->
                <Grid Grid.Row="3" Margin="26,0,26,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{Binding ConnectionBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" Margin="7,0,0,0"
                                   MaxWidth="330" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Text="GhubLite 0.1" FontSize="10" Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <!-- Sync result toast -->
                <Border Grid.RowSpan="4" Panel.ZIndex="50"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,48" Padding="16,9"
                        Background="#121A26" BorderBrush="{Binding ToastBrush}" BorderThickness="1"
                        CornerRadius="12" IsHitTestVisible="False"
                        Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{Binding ToastBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ToastText}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
